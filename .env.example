# Environment variables for Gender Detection

# Flask settings
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Database paths (optional, defaults to project root)
# FEEDBACK_DB_PATH=/path/to/feedback.db.sqlite3
# USERS_DB_PATH=/path/to/users.db.sqlite3

# Model paths (optional)
# MODEL_PATH=/path/to/models/gender_classifier.joblib
# DATASET_PATH=/path/to/data/noms_prenoms_togo.csv

# Training schedule
TRAINING_SCHEDULE_TIME=02:00

# Gunicorn settings (production)
WORKERS=4
TIMEOUT=120
BIND=0.0.0.0:8000
